# ==============================================================================
# Kosmovia - Variables de Entorno de Ejemplo
# NO SUBIR VALORES REALES NI SECRETOS A GITHUB.
# ==============================================================================

# Modo de Servicios (true: mock en memoria/localStorage, false: llamadas reales a backend)
NEXT_PUBLIC_USE_MOCK_API=true

# Stellar Network & RPC (Etapa C)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Supabase (Etapas A y B: Base de datos, autenticación y tiempo real)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API REST (Opcional si se usa servidor Express / Fastify / Polar)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# Borrador de integración con core (ver INTEGRACION.md)
# ------------------------------------------------------------------------------
# "api" conecta la capa de servicios con core; sin valor = demo con localStorage.
NEXT_PUBLIC_KOSMOVIA_SERVICES=api
# Lo usan las piezas copiadas de core (lib/core): sesión con cookie del modo api.
NEXT_PUBLIC_KOSMOVIA_DATA_BACKEND=api
# Clave publicable de Pollar (testnet). La misma de core; pídela por privado.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Dónde corre core (sus rutas /api). En local: core en el puerto 3001.
KOSMOVIA_API_URL=http://localhost:3001
